#!/usr/bin/env bash
source "$(dirname "$0")/_common"
export BOLD_DATA_DIR="$(mktemp -d /private/tmp/bold-maker-e2e.XXXXXX)"
export BOLD_SIMULATION=1
export BOLD_POLL_SECONDS=1
trap 'rm -rf "$BOLD_DATA_DIR"' EXIT

# Playwright's own Chromium is the reproducible choice; a system browser keeps the
# suite runnable offline. Neither is downloaded implicitly here.
if [[ -z "${BROWSER_EXECUTABLE:-}" ]]; then
  for candidate in \
    "$HOME/Library/Caches/ms-playwright"/chromium-*/chrome-mac*/Chromium.app/Contents/MacOS/Chromium \
    /Applications/Google\ Chrome.app/Contents/MacOS/Google\ Chrome \
    /Applications/Chromium.app/Contents/MacOS/Chromium \
    /Applications/Microsoft\ Edge.app/Contents/MacOS/Microsoft\ Edge \
    "$(command -v chromium || true)" "$(command -v google-chrome || true)"
  do
    [[ -x "$candidate" ]] && export BROWSER_EXECUTABLE="$candidate" && break
  done
fi
if [[ -z "${BROWSER_EXECUTABLE:-}" ]]; then
  cat >&2 <<'TEXT'
未找到可用浏览器。请任选一种：
  .venv/bin/python -m playwright install chromium   # 但本仓库用 npm 管理 Playwright
  npm --prefix frontend exec playwright install chromium
  BROWSER_EXECUTABLE='/path/to/Chrome' scripts/test-e2e
TEXT
  exit 2
fi
echo "浏览器：$BROWSER_EXECUTABLE"

.venv/bin/python -m tools.simulator seed
npm --prefix frontend run build
(cd frontend && npm run test:e2e)
