#!/usr/bin/env bash
source "$(dirname "$0")/_common"
if [[ "${1:-}" == '--simulate' ]]; then
  export BOLD_SIMULATION=1
  .venv/bin/python -m tools.simulator seed
fi
if [[ ! -f frontend/dist/index.html ]]; then
  echo '请先运行 scripts/setup 或 npm --prefix frontend run build' >&2
  exit 1
fi
exec .venv/bin/python scripts/server.py start
