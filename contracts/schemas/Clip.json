{
  "$defs": {
    "ErrorCode": {
      "enum": [
        "DEVICE_DISCONNECTED",
        "CAPABILITY_UNVERIFIED",
        "CATALOG_INCOMPLETE",
        "SCOPE_STALE",
        "GROUP_NOT_READY",
        "DOWNLOAD_INCOMPLETE",
        "MEDIA_UNSUPPORTED",
        "STORAGE_FULL",
        "NETWORK_UNAVAILABLE",
        "MODEL_TIMEOUT",
        "MODEL_UPLOAD_NOT_AUTHORIZED",
        "MODEL_OUTPUT_INVALID",
        "STALE_REVISION",
        "CONFLICT",
        "NOT_FOUND",
        "INVALID_INPUT"
      ],
      "title": "ErrorCode",
      "type": "string"
    },
    "ErrorDetail": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "$ref": "#/$defs/ErrorCode"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "retryable": {
          "title": "Retryable",
          "type": "boolean"
        },
        "action": {
          "title": "Action",
          "type": "string"
        },
        "job_id": {
          "anyOf": [
            {
              "pattern": "^[a-zA-Z0-9_-]{1,100}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Job Id"
        }
      },
      "required": [
        "code",
        "message",
        "retryable",
        "action"
      ],
      "title": "ErrorDetail",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "id": {
      "pattern": "^[a-zA-Z0-9_-]{1,100}$",
      "title": "Id",
      "type": "string"
    },
    "name": {
      "title": "Name",
      "type": "string"
    },
    "group_key": {
      "title": "Group Key",
      "type": "string"
    },
    "state": {
      "enum": [
        "awaiting_ready",
        "downloading",
        "preparing",
        "analyzing",
        "analyzed",
        "failed",
        "blocked_format",
        "excluded",
        "queued"
      ],
      "title": "State",
      "type": "string"
    },
    "active": {
      "default": true,
      "title": "Active",
      "type": "boolean"
    },
    "generation": {
      "default": 1,
      "title": "Generation",
      "type": "integer"
    },
    "rendition_id": {
      "anyOf": [
        {
          "pattern": "^[a-zA-Z0-9_-]{1,100}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Rendition Id"
    },
    "duration": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Duration"
    },
    "error": {
      "anyOf": [
        {
          "$ref": "#/$defs/ErrorDetail"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "job_id": {
      "anyOf": [
        {
          "pattern": "^[a-zA-Z0-9_-]{1,100}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Job Id"
    },
    "source": {
      "const": "local",
      "default": "local",
      "title": "Source",
      "type": "string"
    },
    "size": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Size"
    },
    "sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Sha256"
    }
  },
  "required": [
    "id",
    "name",
    "group_key",
    "state"
  ],
  "title": "Clip",
  "type": "object"
}
