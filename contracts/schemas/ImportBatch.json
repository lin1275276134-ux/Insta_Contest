{
  "$defs": {
    "ErrorCode": {
      "enum": [
        "DEVICE_DISCONNECTED",
        "CAPABILITY_UNVERIFIED",
        "CATALOG_INCOMPLETE",
        "SCOPE_STALE",
        "GROUP_NOT_READY",
        "DOWNLOAD_INCOMPLETE",
        "MEDIA_UNSUPPORTED",
        "STORAGE_FULL",
        "NETWORK_UNAVAILABLE",
        "MODEL_TIMEOUT",
        "MODEL_UPLOAD_NOT_AUTHORIZED",
        "MODEL_OUTPUT_INVALID",
        "STALE_REVISION",
        "CONFLICT",
        "NOT_FOUND",
        "INVALID_INPUT"
      ],
      "title": "ErrorCode",
      "type": "string"
    },
    "ErrorDetail": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "$ref": "#/$defs/ErrorCode"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "retryable": {
          "title": "Retryable",
          "type": "boolean"
        },
        "action": {
          "title": "Action",
          "type": "string"
        },
        "job_id": {
          "anyOf": [
            {
              "pattern": "^[a-zA-Z0-9_-]{1,100}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Job Id"
        }
      },
      "required": [
        "code",
        "message",
        "retryable",
        "action"
      ],
      "title": "ErrorDetail",
      "type": "object"
    },
    "ImportItem": {
      "additionalProperties": false,
      "properties": {
        "filename": {
          "title": "Filename",
          "type": "string"
        },
        "status": {
          "enum": [
            "accepted",
            "duplicate",
            "failed"
          ],
          "title": "Status",
          "type": "string"
        },
        "clip_id": {
          "anyOf": [
            {
              "pattern": "^[a-zA-Z0-9_-]{1,100}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Clip Id"
        },
        "job_id": {
          "anyOf": [
            {
              "pattern": "^[a-zA-Z0-9_-]{1,100}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Job Id"
        },
        "error": {
          "anyOf": [
            {
              "$ref": "#/$defs/ErrorDetail"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "filename",
        "status"
      ],
      "title": "ImportItem",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "revision": {
      "title": "Revision",
      "type": "integer"
    },
    "items": {
      "items": {
        "$ref": "#/$defs/ImportItem"
      },
      "title": "Items",
      "type": "array"
    }
  },
  "required": [
    "revision",
    "items"
  ],
  "title": "ImportBatch",
  "type": "object"
}
