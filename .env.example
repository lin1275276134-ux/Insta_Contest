# Copy this file to .env. Never commit the real key.
DASHSCOPE_API_KEY=

# Qwen3-VL, China (Beijing). API keys and endpoints must belong to the same region.
BOLD_MODEL_NAME=qwen3-vl-flash
BOLD_MODEL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
BOLD_MODEL_TIMEOUT=90

# Base64-encoded video must stay below the provider's 10 MB request limit.
BOLD_MODEL_MAX_VIDEO_BYTES=7340032
BOLD_MODEL_VIDEO_FPS=4
BOLD_SEGMENT_SECONDS=30
BOLD_MEDIA_TIMEOUT=1800

# Local storage and upload safeguards.
BOLD_DATA_DIR=data
BOLD_MAX_SOURCE_BYTES=21474836480
BOLD_MIN_FREE_BYTES=1073741824
